# Content-ads configuration. Copy to .env (gitignored) for local runs.
# Every value is OPTIONAL: with nothing set, the tool runs fully in stub mode
# with fallback copy + placeholder images and no Supabase writes.

# --- LLM (shared with phnews) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
IMAGEN_MODEL=imagen-4.0-generate-001

# --- Supabase (same project as phnews) ---
# NOTE: local var is SUPABASE_SERVICE_KEY; in CI it is mapped from the
# GitHub secret SUPABASE_SERVICE_ROLE_KEY (see .github/workflows/daily-ads.yml).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Facebook (stub by default; never spends in v1) ---
FACEBOOK_MODE=stub
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=
FB_PAGE_ID=
FB_PIXEL_ID=

# --- Behaviour ---
CHANNELS=facebook
LANDING_BASE_URL=https://phnews.example/ph
DAILY_AD_BUDGET_CAP=2000
DAILY_AD_LIMIT=3
ADS_DEDUPE_DAYS=14
# A/B creative variants per (topic, language): 1 = primary serious angle only;
# >1 adds reddit/tiktok angle variants for the optimization loop to compare.
VARIANTS_PER_TOPIC=1
# local | supabase  (supabase hosts images in the 'ad-creatives' Storage bucket)
IMAGE_STORE=local
