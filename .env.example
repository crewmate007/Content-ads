# Content-ads configuration. Copy to .env (gitignored) for local runs.
# Every value is OPTIONAL: with nothing set, the tool runs fully in stub mode
# with fallback copy + placeholder images and no Supabase writes.

# --- Copy LLM (shared with phnews) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Image model (OpenAI gpt-image-2) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Comma-separated Facebook aspect ratios. 1:1 Feed, 9:16 Story/Reel, 4:5 Feed.
IMAGE_ASPECT_RATIOS=1:1

# --- Supabase (same project as phnews) ---
# NOTE: local var is SUPABASE_SERVICE_KEY; in CI it is mapped from the
# GitHub secret SUPABASE_SERVICE_ROLE_KEY (see .github/workflows/daily-ads.yml).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Facebook (stub by default; never spends in v1) ---
FACEBOOK_MODE=stub
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=
FB_PAGE_ID=
FB_PIXEL_ID=
# Placements -> aspect ratios served via asset_feed_spec. e.g. FEED,STORY,REELS
FB_PLACEMENTS=FEED
FB_CAMPAIGN_OBJECTIVE=OUTCOME_TRAFFIC
FB_OPTIMIZATION_GOAL=LINK_CLICKS
FB_BID_STRATEGY=LOWEST_COST_WITHOUT_CAP

# --- Performance-data-informed copy (few-shot from winning ads) ---
FEW_SHOT_ENABLED=true
FEW_SHOT_EXAMPLES_COUNT=3
FEW_SHOT_LOOKBACK_DAYS=7

# --- Creative-quality eval (scrappy, non-blocking) ---
CREATIVE_QUALITY_EVAL_ENABLED=false
COPY_BASELINE_DIVERGENCE_THRESHOLD=0.3

# --- Behaviour ---
CHANNELS=facebook
LANDING_BASE_URL=https://phnews.example/ph
DAILY_AD_BUDGET_CAP=2000
DAILY_AD_LIMIT=3
ADS_DEDUPE_DAYS=14
# A/B creative variants per (topic, language): 1 = primary serious angle only;
# >1 adds reddit/tiktok angle variants for the optimization loop to compare.
VARIANTS_PER_TOPIC=1
# local | supabase  (supabase hosts images in the 'ad-creatives' Storage bucket)
IMAGE_STORE=local
